# MeenMitra backend configuration — placeholders and safe local defaults only.
# Copy to backend/.env for local overrides. Never commit real credentials.

# deployment label shown in API metadata (local | demo | staging)
APP_ENV=local

# Comma-separated list of browser origins allowed by CORS (the local Next.js dev server by default)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite file for local demo persistence (relative paths resolve from backend/)
DATABASE_PATH=data/meenmitra_demo.db

# Seed synthetic demo records automatically when the database is empty
SEED_ON_STARTUP=true

# Allow POST /api/v1/demo/reset to wipe and re-seed the demo database (keep false outside local demos)
ALLOW_DEMO_RESET=false

# Weather source for forecasts: "demo" (offline scenario presets) or "open_meteo" (optional, falls back to demo on failure)
WEATHER_PROVIDER=demo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=5

# Alert delivery provider. Only "mock" is implemented; it never contacts real phone numbers.
ALERT_PROVIDER=mock

# Demo risk classification boundaries on the 0-100 relative risk index (demonstration settings, not validated)
RISK_WATCH_THRESHOLD=40
RISK_DANGER_THRESHOLD=70

# ML workspace locations (relative paths resolve from backend/)
ML_DATA_DIR=data/raw
ML_ARTIFACTS_DIR=artifacts

# Future real messaging providers (NOT implemented). Leave blank; see docs/ALERTS.md before enabling anything.
# WHATSAPP_PROVIDER_API_KEY=
# SMS_PROVIDER_API_KEY=
# VOICE_PROVIDER_API_KEY=
