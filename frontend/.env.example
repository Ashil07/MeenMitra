# Copy to .env.local and adjust. No secrets belong in this file —
# every NEXT_PUBLIC_* value is shipped to the browser.

# "mock"  = typed demo fixtures inside the browser (no backend needed, data clearly labelled DEMO)
# "live"  = call the FastAPI backend at NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_API_MODE=mock

# Base URL of the backend. The client appends /api/v1/... to this.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
